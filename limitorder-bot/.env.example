# Network Configuration
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
CHAIN_ID=11155111

# Wallet Configuration
PRIVATE_KEY=your_private_key_here

# Contract Addresses
HOOK_ADDRESS=0x...
POOL_MANAGER_ADDRESS=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543

# Pool Configuration (ETH/USDC example)
CURRENCY_0=0x...  # Token A address
CURRENCY_1=0x...  # Token B address
FEE=3000          # 0.3%
TICK_SPACING=60
HOOKS=0x...       # Hook address (same as HOOK_ADDRESS)

# Bot Configuration
CHECK_INTERVAL=60000          # Check every 60 seconds
MAX_GAS_PRICE=100             # Max gas price in gwei
MAX_ORDERS_PER_EXECUTION=5    # Execute max 5 orders per run
